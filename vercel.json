{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm ci --prefix web",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "web/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/((?!api/|images/|assets/|videos/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "data/**,db/**,lib/**,server/**,schema.ts,trefle/**",
      "excludeFiles": "{node_modules/better-sqlite3/**,db/client.ts,db/plant-repository-sqlite.ts}"
    }
  }
}

{
  "name": "naturelover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "npm run dev --prefix web",
    "dev:all": "concurrently -n api,web -c green,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "start": "tsx server/index.ts",
    "db:seed": "tsx db/sync-trefle.ts",
    "db:reset": "rm -f data/naturelover.db data/trefle-sync-state.json && TREFLE_CLEAR_DB=true tsx db/sync-trefle.ts",
    "db:seed:status": "cat data/trefle-sync-state.json 2>/dev/null || echo 'No sync in progress'",
    "db:backfill-edible": "tsx db/backfill-edible.ts",
    "db:backfill-native": "tsx db/backfill-native-states.ts",
    "db:backfill-us": "tsx db/backfill-us-scope.ts",
    "enrich:trefle": "tsx scripts/enrich-from-trefle.ts",
    "db:sync-seed": "tsx scripts/sync-seed-plants.ts",
    "db:sync-state-seeds": "tsx scripts/sync-state-seed-plants.ts",
    "db:sync-state-seeds:enrich": "tsx scripts/sync-state-seed-plants.ts --enrich",
    "seeds:build-state-comprehensive": "tsx scripts/build-state-comprehensive-seeds.ts",
    "seeds:build-ct-master": "tsx scripts/build-state-master-catalog.ts --state=CT",
    "seeds:build-tn-master": "tsx scripts/build-state-master-catalog.ts --state=TN",
    "harvest:web:tn": "tsx scripts/harvest-web-state-catalog.ts --state=TN --enrich --images",
    "harvest:web:ct": "tsx scripts/harvest-web-state-catalog.ts --state=CT --enrich --images",
    "harvest:web:both": "tsx scripts/harvest-web-state-catalog.ts --state=both --enrich --images",
    "harvest:web:discover": "tsx scripts/harvest-web-state-catalog.ts --state=both --discover-only",
    "import:state:tn": "tsx scripts/harvest-web-state-catalog.ts --state=TN --enrich --images",
    "import:state:ct": "tsx scripts/harvest-web-state-catalog.ts --state=CT --enrich --images",
    "import:state:both": "tsx scripts/harvest-web-state-catalog.ts --state=both --enrich --images",
    "import:state:trefle:tn": "tsx scripts/import-state-catalog.ts --state=TN --seeds --trefle --enrich --images",
    "import:state:trefle:ct": "tsx scripts/import-state-catalog.ts --state=CT --seeds --trefle --enrich --images",
    "db:tag-state-plants": "tsx scripts/tag-state-plants-in-db.ts",
    "images:fetch:tn": "tsx scripts/fetch-plant-images.ts --state=TN",
    "images:fetch:ct": "tsx scripts/fetch-plant-images.ts --state=CT",
    "db:backfill-profiles": "tsx scripts/backfill-designer-profiles.ts",
    "db:sync-seed:enrich": "tsx scripts/sync-seed-plants.ts --enrich",
    "images:fetch": "tsx scripts/fetch-plant-images.ts --source=ifas",
    "images:fetch:inat": "tsx scripts/fetch-plant-images.ts --source=ifas --replace-non-inat --inat-only",
    "images:fetch:all": "tsx scripts/fetch-plant-images.ts",
    "images:fetch:vh021-fruit": "tsx scripts/fetch-cultivar-fruit-images.ts",
    "build:vercel": "npm run build --prefix web",
    "db:migrate:supabase": "tsx scripts/migrate-sqlite-to-supabase.ts",
    "db:migrate:supabase:resume": "tsx scripts/migrate-sqlite-to-supabase.ts -- --resume",
    "db:fix:supabase-json": "tsx scripts/fix-supabase-jsonb.ts",
    "db:status:supabase": "tsx scripts/db-status-supabase.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "better-sqlite3": "^11.9.1",
    "hono": "^4.7.10",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}

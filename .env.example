# Web (Vite) — leave unset on Vercel (same-origin /api). Local dev uses vite proxy.
# VITE_API_URL=
# Public site URL for Open Graph link previews (recommended on Vercel if previews show no image).
# Vercel also sets VERCEL_PROJECT_PRODUCTION_URL at build; override with your canonical domain:
# VITE_SITE_URL=https://ntrlvr.vercel.app

# ─── Supabase (Vercel / production) ───
# Postgres (plant queries) — Project Settings → Database → Connection string (URI)
# Vercel/serverless: Transaction pooler port 6543 + ?pgbouncer=true
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Bulk migrate locally: direct host db.[ref].supabase.co port 5432 (not the pooler)
#
# Admin API (health check, bypasses RLS) — Project Settings → API
# SUPABASE_URL=https://[ref].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local SQLite path (default: data/naturelover.db) when DATABASE_URL is unset
# DATABASE_PATH=./data/naturelover.db

# Trefle.io API token — https://trefle.io/users/sign_in
# TREFLE_API_KEY=   (alias for TREFLE_API_TOKEN)
TREFLE_API_TOKEN=your-token-here

TREFLE_MAX_REQUESTS_PER_RUN=100
TREFLE_FETCH_DETAILS=false

# TREFLE_FILTER_EDIBLE=true
# TREFLE_FILTER_VEGETABLE=true
# TREFLE_FILTER_HAS_IMAGE=true

# Web harvest (iNaturalist + GBIF + USDA — not Trefle-only)
# WEB_HARVEST_INAT_MAX=3500
# WEB_HARVEST_GBIF_MAX=3000
# IMPORT_ENRICH_MAX=800
# IMAGE_FETCH_DELAY_MS=500

# Backfill US scope + hardiness zones for existing rows
# BACKFILL_US_MAX=500 npm run db:backfill-us

# ─── Anthropic (designer Auto-fill + optional companion AI) ───
# Get a key: https://console.anthropic.com/settings/api-keys
# Paste your key after the = (no quotes). Restart `npm run dev` after saving.
ANTHROPIC_API_KEY=your-anthropic-key-here

# ANTHROPIC_MODEL=claude-haiku-4-5
# FOOD_FOREST_LAYOUT_AI=false
# COMPANION_REASON_AI=true

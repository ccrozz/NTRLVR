# Trefle.io API token — https://trefle.io/users/sign_in
# TREFLE_API_KEY=   (alias for TREFLE_API_TOKEN)
TREFLE_API_TOKEN=your-token-here

TREFLE_MAX_REQUESTS_PER_RUN=100
TREFLE_FETCH_DETAILS=false

# TREFLE_FILTER_EDIBLE=true
# TREFLE_FILTER_VEGETABLE=true
# TREFLE_FILTER_HAS_IMAGE=true

# Backfill US scope + hardiness zones for existing rows
# BACKFILL_US_MAX=500 npm run db:backfill-us

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": "."
  },
  "include": [
    "schema.ts",
    "server/**/*.ts",
    "db/**/*.ts",
    "lib/**/*.ts",
    "trefle/**/*.ts",
    "data/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "web"]
}
